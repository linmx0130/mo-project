# mo.toml — mo agent harness configuration
#
# Copy this file to `mo.toml` in the project folder (the gateway's working
# directory), or to `$HOME/.config/mo-agents/mo.toml`, and fill in your
# models. The gateway looks in `$PWD/mo.toml` first, then
# `$HOME/.config/mo-agents/mo.toml`; an explicit path can be given with
# `mo_gateway --config <file>`.
#
# With no config file at all, the gateway falls back to the legacy `MO_*`
# env vars (MO_MODEL_BASE_URL / MO_MODEL_NAME / MO_AUTH_TOKEN / ...).

# Runtime data dir (default ./data): mo.db + sessions/<id>/ journals.
# data_dir = "./data"

# Global agents dir (default $HOME/.agents): global AGENTS.md + skills.
# agents_dir = "~/.agents"

# Gateway HTTP port (default 3031).
# port = 3031

# Gateway listen address (default "0.0.0.0"). When nginx fronts the gateway,
# set this to "127.0.0.1" so the public network can never reach the gateway
# directly — only the proxy can.
# bind = "0.0.0.0"

# UI accent (theme) color for the web frontend, as a hex value (#RGB or
# #RRGGBB). Default "#009dc4" (deep cyan). Light mode uses the color verbatim
# (translucent tints are derived from it); dark mode auto-lightens it for
# contrast on the dark background.
# theme_color = "#009dc4"

# Accepted for backward compatibility (its value no longer changes
# behavior): root sessions are always depth 0 — never framed as subagents —
# and subagent nesting is hard-capped at 1 (a subagent can never spawn
# further subagents).
# subagent_depth = 0

# Max number of tool calls from a single assistant message that execute
# concurrently (default 8, clamped to at least 1). Tool calls in one message
# run in parallel up to this bound — the UI shows all tool blocks at once
# and each completes independently. Dependent calls should still go in
# separate messages (completion order is not guaranteed).
# max_tool_concurrency = 8

# Fraction of the model's context_window at which the worker asks the model
# to generate a *handoff prompt* and starts sending only the compressed
# context (default 0.75; 0 < value <= 1). Only applies when the session's
# model sets a context_window — without one the window is unlimited and no
# compression happens. When the threshold is hit, the worker asks the model
# to summarize the conversation (original input, environment facts,
# decisions, progress, next step) into a handoff prompt, journals it as a
# `handoff` event, rebuilds the system prompt for the current mode, and from
# then on sends only the handoff (plus anything after it) to the model —
# the earlier events stay in the journal and stay visible in the UI.
# context_compression_threshold = 0.75

# Worker binary (default: sibling of the mo_gateway executable named
# mo_worker).
# worker_bin = "./target/debug/mo_worker"

# Models — at least one is required. The first model defined here is the
# default: it is used to launch jobs and generate session titles, and it is
# pre-selected in the "New session" UI. Every model needs a base_url and a
# name; token is optional (omit it for endpoints without auth) and nickname
# is an optional label shown in the UI.
#
# context_window is optional: the model's context window in tokens. When
# set, the session status bar shows the current context length against it
# (with a progress bar); when absent the window is treated as unlimited and
# only the current length is shown. The context length itself comes from the
# LLM API (`usage.prompt_tokens` of each chat completion).
[[models]]
base_url = "https://api.deepseek.com"
name = "deepseek-v4-flash"
token = "sk-..."
# nickname = "deepseek"
# context_window = 65536

# A second model, e.g. a local mock for smoke tests:
[[models]]
base_url = "http://127.0.0.1:9001"
name = "smoke-model"
nickname = "mock"
